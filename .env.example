# Cockpit OS — environment

# Firebase. If unset, the MCP server runs in DRY-RUN mode (no writes hit Firestore).
# Either provide a service account JSON path:
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or set explicit project config:
# FIREBASE_PROJECT_ID=cockpit-os-dev

# Optional: force dry-run even if creds are present (useful in CI / OpenClaw skill testing).
COCKPIT_DRY_RUN=0

# Where the compiler writes generated SKILL.md folders.
# Point this at your OpenClaw workspace skills dir in production.
COCKPIT_SKILLS_OUT=./skills-out
